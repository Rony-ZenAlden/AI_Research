# Copy to .env and adjust for local dev
# ----- Django -----
DJANGO_SETTINGS_MODULE=NeuroSeek_AI.settings.dev
DJANGO_SECRET_KEY=change-me-in-prod-please-use-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# ----- Database (Postgres + pgvector) -----
POSTGRES_DB=neuroseek
POSTGRES_USER=neuroseek
POSTGRES_PASSWORD=neuroseek_dev_pw
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ----- Redis -----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNELS_REDIS_URL=redis://redis:6379/3

# ----- App -----
TIME_ZONE=UTC
LANGUAGE_CODE=en-us

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ----- JWT -----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ----- Embeddings -----
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
HF_HOME=/app/.hf_cache

# ----- Web research (SearXNG) -----
SEARXNG_BASE_URL=http://searxng:8080
SEARXNG_SECRET=replace-with-long-random-string-in-prod

# ----- Scraping fallback (Jina Reader) -----
USE_JINA_FALLBACK=True
JINA_API_KEY=

# ----- LLM (Ollama; both local and cloud models supported) -----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:1.5b
# OLLAMA_MODEL=gpt-oss:120b-cloud      # bigger; needs `ollama signin`
# OLLAMA_MODEL=qwen3-coder:480b-cloud
# OLLAMA_MODEL=kimi-k2:1t-cloud
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=900
